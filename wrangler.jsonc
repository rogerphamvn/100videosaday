{
  "name": "100videosaday",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [{
    "binding": "AUTH_DB",
    "database_name": "100videosaday-auth",
    "database_id": "adbb30ba-272b-4d23-bf21-4118cf30fc0f",
    "migrations_dir": "cloudflare/migrations"
  }],
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none" }
}
